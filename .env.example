# Storage backend: "memory" (dev, no creds) or "supabase" (integration)
BACKEND=memory

# --- Supabase (worker uses the SERVICE key; never expose it to the browser) ---
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# --- Crawler ---
BROWSERLESS_TOKEN=

# --- Google: enable Places + PageSpeed Insights + CrUX on this key ---
GOOGLE_API_KEY=

# --- SpyFu enrichment (client plan; graceful fallback if absent) ---
SPYFU_API_KEY=

# --- AI report copy ---
ANTHROPIC_API_KEY=

# --- Booking webhook signature verification ---
CALCOM_WEBHOOK_SECRET=

# --- Public base URL for /r/{slug} links ---
APP_BASE_URL=http://localhost:3000

# --- Admin dashboard token (any strong secret string) ---
ADMIN_TOKEN=
